# Safe application defaults
APP_ENV=development
APP_NAME=Nile Connect Support AI
PROFILE_STORAGE=sqlite
QDRANT_MODE=container
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=we_knowledge_base
MONGO_DB=we_telecom_db
SQLITE_PATH=data/we_telecom.db

# Required for live agent use. Never commit actual values.
GOOGLE_API_KEY=
MONGO_URI=mongodb://mongo:27017
SETTINGS_ENCRYPTION_KEY=
SETTINGS_ADMIN_TOKEN=

# Optional: only for Qdrant Cloud or another protected external Qdrant instance.
# Leave empty for the local Docker Qdrant container above.
QDRANT_API_KEY=
